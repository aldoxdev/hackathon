# Copiar a .env y ajustar segun el entorno.
# Local: sqlite (cero configuracion). Render: postgres (ver docs de Render para la URL).
DATABASE_URL=sqlite:///./dev.db
CORS_ORIGINS=http://localhost:3000
# Necesaria para el asistente de IA (chatbot). Sacala en platform.openai.com/api-keys.
# NUNCA la escribas aqui ni la subas a git — solo va en tu .env local o en las variables de
# entorno de Render.
OPENAI_API_KEY=
